# ---- Server ----
NODE_ENV=development
PORT=5000
# Number of reverse-proxy hops to trust (0 = none). Needed for correct client IPs behind nginx/etc.
TRUST_PROXY=0
BODY_LIMIT=1mb

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=land_registry_chain
DB_USER=lrc_app
DB_PASSWORD=change_me_runtime
# Separate account used only by sequelize-cli migrations
DB_MIGRATION_USER=lrc_migrator
DB_MIGRATION_PASSWORD=change_me_migration
DB_NAME_TEST=land_registry_chain_test
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_MS=2000
# If true, the server refuses to start when MySQL is unreachable.
DB_REQUIRE_ON_STARTUP=true

# ---- CORS (comma-separated list of approved frontend origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---- Rate limiting (global) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Authentication ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---- Document storage ----
UPLOAD_DIR=uploads

# ---- Blockchain integration (optional) ----
# Leave blank to keep the outbox disabled. The worker/listener log and exit when unset.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=
