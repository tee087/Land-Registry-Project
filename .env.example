# Used by docker-compose.yml. Copy to .env and replace both secrets.
DB_NAME=land_registry_chain
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_database_password
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:8080

# Cloudflare Turnstile: private secret goes on the backend; public site key goes in VITE_TURNSTILE_SITE_KEY on Vercel.
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostname allowlist; defaults to FRONTEND_URL hostname.
TURNSTILE_HOSTNAMES=
GOOGLE_CLIENT_ID=

# Optional blockchain integration (leave blank to keep the outbox disabled)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
