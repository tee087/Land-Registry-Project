# Used by docker-compose.yml. Copy to .env and change the secrets.
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=land_registry_chain
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:8080

# Optional blockchain integration (leave blank to keep the outbox disabled)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
