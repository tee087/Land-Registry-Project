# Used by docker-compose.yml. Copy to .env and replace both secrets.
DB_NAME=land_registry_chain
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_database_password
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:8080

# Optional blockchain integration (leave blank to keep the outbox disabled)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
